      "sass": "./styles/index.scss"
    },
    "./fonts.css": "./styles/fonts.css",
    "./dark-theme": {
      "style": "./styles/_dark-theme.scss"
    },
    "./light-theme": {
      "style": "./styles/_light-theme.scss"
    },
    "./ocean-theme": {
      "style": "./styles/_ocean-theme.scss"
    },
    "./amber-theme": {
      "style": "./styles/_amber-theme.scss"
    },
    "./rose-theme": {
      "style": "./styles/_rose-theme.scss"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "private": false
}
