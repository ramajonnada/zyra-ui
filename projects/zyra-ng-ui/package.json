{
  "name": "zyra-ng-ui",
  "version": "3.2.0",
  "description": "ZyraUI – Modern Angular UI Components",
  "author": "Rama Jonnada",
  "license": "MIT",
  "peerDependencies": {
    "@angular/core": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/forms": "^21.0.0"
  },
  "exports": {
    ".": {
      "sass": "./styles/index.scss"
    },
